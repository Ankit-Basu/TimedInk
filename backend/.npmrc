# Build hosts (Render, Railway, Fly.io) set NODE_ENV=production, and `npm ci`
# honours that by dropping devDependencies — which is where every @types/*
# package the TypeScript build needs lives. Forcing it here means the build
# works from a clean clone regardless of what the platform sets, instead of
# depending on a --include=dev flag being present in a dashboard field.
include=dev
