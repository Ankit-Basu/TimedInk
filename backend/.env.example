# ---------------------------------------------------------------------------
# TimedInk - backend configuration
#
# Copy to `.env` and adjust. Every value below is a working local default:
# with `docker compose up -d` running, this file works as-is except for
# JWT_SECRET, which you should change.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public origin of THIS api. Used to build tracking-pixel URLs, so it must be
# reachable by whatever renders the email.
APP_BASE_URL=http://localhost:4000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# Port 3307 matches docker-compose.yml, which maps host 3307 -> container 3306
# so it cannot collide with a natively-installed MySQL.
DATABASE_URL="mysql://root:outbox@localhost:3307/outbox_pilot"

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# CHANGE THIS. Minimum 16 characters; the app refuses to boot otherwise.
JWT_SECRET=dev-only-change-me-please-32chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
# Human-readable coloured logs. Defaults to true outside production.
LOG_PRETTY=true

# --- Email --------------------------------------------------------------
#
# DEFAULT (what the demo uses): leave every credential below BLANK. On first
# boot the worker provisions a throwaway Ethereal inbox and logs the
# credentials once; paste them back here to keep one inbox across restarts.
#
#   IMPORTANT: Ethereal is a capture-only SMTP sink. It accepts your message,
#   gives you a web preview, and DISCARDS it. Mail sent to a real address will
#   never arrive in that inbox. That is the whole point of the service — it
#   lets you exercise real SMTP without spamming anyone.
#
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Sending real mail instead ---------------------------------------------
#
# SMTP_USER / SMTP_PASS are the same slot as ETHEREAL_USER / ETHEREAL_PASS and
# take precedence. Point SMTP_HOST at a real provider, fill these in, and mail
# is genuinely delivered. Nothing else in the app changes.
#
# Gmail (needs 2FA on the account, then an App Password — not your login):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-character app password, no spaces>
#
# Brevo (300/day free):        smtp-relay.brevo.com : 587
# Resend (100/day free):       smtp.resend.com : 587, user "resend", pass = API key
# Mailgun / Postmark / SES:    whatever host and credentials they issue
#
#   NOTE: most providers only let you send FROM an address you have verified.
#   The From header comes from the Mailbox row, so update the seeded mailboxes
#   to an address you own first — either through POST /api/mailboxes, or:
#     npx prisma studio   ->  mailboxes  ->  edit fromEmail
#   Gmail in particular rewrites a mismatched From to the authenticated account.
#
SMTP_USER=
SMTP_PASS=

# --- Queue / worker --------------------------------------------------------
EMAIL_QUEUE_NAME=outbox-emails

# How many jobs ONE worker process runs at once (local resource bound).
WORKER_CONCURRENCY=5

# Simulated provider send-rate cap, enforced across ALL workers via Redis.
# 10 per 10s makes a 40-email burst drain in visible batches.
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION_MS=10000

# Retry policy for transient send failures (exponential backoff).
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000

# On boot, a PENDING/QUEUED email more than this many minutes past due is NOT
# auto-sent - it is failed with "missed window, flagged for manual review".
# 1440 = 24h. Set to something small (e.g. 2) to demo the stale path.
STALE_CATCHUP_THRESHOLD_MINUTES=1440

# --- Bonus layers ----------------------------------------------------------
# Bonus B: per-mailbox warmup throttling (day N -> min(10*N, 100) sends/day).
WARMUP_ENABLED=true
# How long a job sleeps when its mailbox is at its daily cap.
WARMUP_RETRY_DELAY_MS=60000

# Bonus C: round-robin sending across a user's mailboxes.
MAILBOX_ROTATION_ENABLED=true
# How often the worker sweeps for unopened emails past their follow-up window.
FOLLOWUP_CHECK_INTERVAL_MS=60000

# --- Dev tooling -----------------------------------------------------------
# Bull Board at /admin/queues. UNAUTHENTICATED - keep false in production.
BULL_BOARD_ENABLED=true

# --- Seed / demo scripts ---------------------------------------------------
SEED_USER_EMAIL=demo@timedink.dev
SEED_USER_PASSWORD=demo1234
SEED_USER_NAME=Demo Operator

# The two seeded sending mailboxes. Leave these alone for the Ethereal demo.
# If you switch SMTP_HOST to a real provider, set both to an address you own —
# providers only send from a verified sender.
SEED_MAILBOX_A_NAME=Ava from TimedInk
SEED_MAILBOX_A_EMAIL=ava@timedink.dev
SEED_MAILBOX_B_NAME=Ben from TimedInk
SEED_MAILBOX_B_EMAIL=ben@timedink.dev
