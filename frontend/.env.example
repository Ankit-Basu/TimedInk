# ---------------------------------------------------------------------------
# TimedInk - frontend configuration
#
# Copy to `.env` (optional - the defaults below are what `npm run dev` uses).
# ---------------------------------------------------------------------------

# NOTE: there is deliberately no VITE_API_BASE_URL. Every request the app makes
# is same-origin; which server answers /api/* is decided by a proxy, not by the
# bundle — `server.proxy` in vite.config.ts locally, and the /api rewrite in
# vercel.json when deployed. To point at a different API, change the proxy.

# Target the dev-server proxy forwards /api to.
VITE_API_PROXY_TARGET=http://localhost:4000

# Google sign-in needs no frontend variable: the button asks the API for the
# client id (GET /api/auth/config), so it is configured once, in backend/.env.

# How often the dashboard re-fetches, in milliseconds. In a larger system this
# would be a WebSocket/SSE subscription instead of polling.
VITE_POLL_INTERVAL_MS=4000
